# Runtime web process (scoringsys_app)
DATABASE_URL=postgresql://scoringsys_app:<password>@localhost:5432/scoringsys
ADMIN_SESSION_SECRET=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=

# Migration/import jobs only (scoringsys_migrator; never inject into web)
MIGRATOR_DATABASE_URL=postgresql://scoringsys_migrator:<password>@localhost:5432/scoringsys
