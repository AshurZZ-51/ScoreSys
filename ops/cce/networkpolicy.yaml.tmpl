apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: scoringsys-egress
  namespace: "{{NAMESPACE}}"
  annotations:
    scoringsys.io/postgres-service: "{{POSTGRES_SERVICE_NAME}}"
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: scoringsys
  policyTypes:
    - Egress
  egress:
    - to:
        - podSelector:
            matchLabels:
              "{{POSTGRES_POD_LABEL_KEY}}": "{{POSTGRES_POD_LABEL_VALUE}}"
      ports:
        - protocol: TCP
          port: 5432
    - to:
        - namespaceSelector: {}
      ports:
        - protocol: UDP
          port: 53
    - to:
        - namespaceSelector: {}
      ports:
        - protocol: TCP
          port: 53
