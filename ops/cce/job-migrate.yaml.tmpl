apiVersion: batch/v1
kind: Job
metadata:
  name: scoringsys-migrate
  namespace: "{{NAMESPACE}}"
  labels:
    app.kubernetes.io/name: scoringsys
    app.kubernetes.io/component: migrator
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: scoringsys
        app.kubernetes.io/component: migrator
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      imagePullSecrets:
        - name: "{{IMAGE_PULL_SECRET}}"
      containers:
        - name: migrator
          image: "{{IMAGE_REFERENCE}}"
          imagePullPolicy: IfNotPresent
          command: ["node", "scripts/db/migrate.mjs", "--fail-fast"]
          envFrom:
            - secretRef:
                name: "{{MIGRATOR_SECRET_NAME}}"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
